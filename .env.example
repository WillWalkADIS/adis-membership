# Copy these into Railway -> your service -> Variables.

# --- Database (Railway sets this automatically when you add Postgres) ---
DATABASE_URL=

# --- Public address, used in emailed card and renewal links ---
SITE_BASE_URL=https://www.joinadis.com

# --- Committee dashboard login ---
ADMIN_EMAIL=will@edn-investments.com
# Generate with: npm run hash-password -- "your new password"
ADMIN_PASSWORD_HASH=

# --- Session signing key (any long random string) ---
SESSION_SECRET=

# --- Email sending (Resend) ---
RESEND_API_KEY=
MAIL_FROM=ADIS Membership <membership@joinadis.com>
MAIL_REPLY_TO=

# --- Optional ---
# true = email the membership card at sign-up instead of waiting for payment
ISSUE_CARD_ON_REGISTRATION=false
# true = log emails instead of sending them (for testing)
MAIL_DRY_RUN=false
